<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- App theme based on figma styles -->
    <style name="Base.Theme.PantryBuddy" parent="Theme.Material3.Light.NoActionBar">
        <!-- Main brand and background colors -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="colorPrimary">@color/colorAccentClay</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorAccentGreen</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorOutline">@color/colorBorder</item>
        <item name="colorError">@color/colorDangerRose</item>

        <!-- Text colors and fonts -->
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="android:fontFamily">@font/inter</item>

        <!-- Status and nav bar colors -->
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/colorSurface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.PantryBuddy" parent="Base.Theme.PantryBuddy" />

    <!-- Text styles -->
    <style name="TextAppearance.PantryBuddy.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/lora</item>
        <item name="android:fontFamily">@font/lora</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="TextAppearance.PantryBuddy.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/lora</item>
        <item name="android:fontFamily">@font/lora</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="TextAppearance.PantryBuddy.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="TextAppearance.PantryBuddy.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_body_primary</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextAppearance.PantryBuddy.BodyMuted" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_body_secondary</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
    </style>

    <style name="TextAppearance.PantryBuddy.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_badge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.PantryBuddy.Timer" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_timer</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <!-- Component styles like cards and buttons -->
    <style name="Widget.PantryBuddy.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="strokeColor">@color/colorBorder</item>
        <item name="strokeWidth">@dimen/stroke_border</item>
        <item name="cardElevation">@dimen/elevation_card</item>
    </style>

    <style name="Widget.PantryBuddy.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="backgroundTint">@color/colorAccentClay</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.PantryBuddy.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="strokeColor">@color/colorBorder</item>
        <item name="strokeWidth">@dimen/stroke_border</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.PantryBuddy.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/colorBackground</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PantryBuddy.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.PantryBuddy.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSizeTopLeft">@dimen/radius_sheet</item>
        <item name="cornerSizeTopRight">@dimen/radius_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.PantryBuddy.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/colorPillNeutral</item>
    </style>
</resources>