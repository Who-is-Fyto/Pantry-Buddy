<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <!-- Column 1: Ingredient Name with Status Icon -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1.4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivIngredientStatus"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check"
            tools:tint="@color/colorAccentGreen" />

        <TextView
            android:id="@+id/tvIngredientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:maxLines="2"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp"
            tools:text="Tomatoes" />
    </LinearLayout>

    <!-- Column 2: Needed Quantity -->
    <TextView
        android:id="@+id/tvIngredientNeeded"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1.0"
        android:fontFamily="@font/inter"
        android:textColor="@color/colorTextPrimary"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="200 g" />

    <!-- Column 3: At Home Quantity and Shortfall Tag -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvIngredientAtHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            tools:text="300 g" />

        <TextView
            android:id="@+id/tvIngredientDifference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter"
            android:textColor="@color/colorDangerRose"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Short 50 g"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>
