<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorBackground"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/colorTextPrimary"
            app:title="Recipe Details"
            app:titleTextAppearance="@style/TextAppearance.PantryBuddy.Headline"
            app:titleTextColor="@color/colorTextPrimary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="120dp">

            <!-- Hero Image Banner -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivRecipeHero"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="4dp"
                android:background="@color/colorPillNeutral"
                android:padding="32dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_restaurant"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large"
                app:tint="@color/colorTextSecondary" />

            <!-- Title & Description -->
            <TextView
                android:id="@+id/tvRecipeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/lora"
                android:textColor="@color/colorTextPrimary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Tomato &amp; Spinach Scramble" />

            <TextView
                android:id="@+id/tvRecipeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                tools:text="A quick, nourishing skillet scramble utilizing fresh greens and juicy tomatoes." />

            <!-- Metadata Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Cook Time -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_neutral"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/colorTextSecondary" />

                    <TextView
                        android:id="@+id/tvRecipeCookTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp"
                        tools:text="15 min" />
                </LinearLayout>

                <!-- Difficulty -->
                <TextView
                    android:id="@+id/tvRecipeDifficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_neutral"
                    android:fontFamily="@font/inter"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/colorAccentClay"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Easy" />

                <!-- Base Servings -->
                <TextView
                    android:id="@+id/tvRecipeBaseServings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_neutral"
                    android:fontFamily="@font/inter"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp"
                    tools:text="Default: 2 servings" />
            </LinearLayout>

            <!-- Dynamic Serving Scaler Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.08"
                        android:text="DYNAMIC SERVING SCALER"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Scaler Stepper Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDecrementServings"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_remove"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@color/colorTextPrimary"
                            app:strokeColor="@color/colorBorder" />

                        <TextView
                            android:id="@+id/tvCurrentServings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter"
                            android:gravity="center"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="2 servings" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnIncrementServings"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_add"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@color/colorTextPrimary"
                            app:strokeColor="@color/colorBorder" />
                    </LinearLayout>

                    <!-- Limit indicator notice -->
                    <TextView
                        android:id="@+id/tvServingLimitNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_pill_green"
                        android:fontFamily="@font/inter"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:textColor="@color/colorAccentGreen"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="2 servings (Maximum with your 4 eggs)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3-Column Verification Table Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Table Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1.4"
                            android:fontFamily="@font/inter"
                            android:letterSpacing="0.08"
                            android:text="INGREDIENT"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1.0"
                            android:fontFamily="@font/inter"
                            android:letterSpacing="0.08"
                            android:text="NEEDED"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:fontFamily="@font/inter"
                            android:letterSpacing="0.08"
                            android:text="AT HOME"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorBorderLight" />

                    <!-- Container for ingredient verification rows -->
                    <LinearLayout
                        android:id="@+id/llIngredientVerificationRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Post-Cooking Projection Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPostCookingProjection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/colorPillNeutral"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.08"
                        android:text="POST-COOKING PROJECTION"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPostCookingProjection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="13sp"
                        tools:text="Quantities leave 100 g tomatoes and 20 g spinach for later." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Bottom CTA Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/colorSurface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="@color/colorBorder" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartCooking"
            style="@style/Widget.PantryBuddy.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start cooking · 2 servings"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconTint="@color/white" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
