<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- Prominent Top Divider (shown for Almost There section) -->
    <View
        android:id="@+id/viewSectionDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="@color/colorBorder"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Amber Badge: MISSING 1 INGREDIENT - SHOPPING REQUIRED -->
    <LinearLayout
        android:id="@+id/layoutAmberSectionBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_pill_amber"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_alert_amber" />

        <TextView
            android:id="@+id/tvAmberSectionBadgeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/inter"
            android:text="MISSING 1 INGREDIENT — SHOPPING REQUIRED"
            android:textColor="@color/colorAccentAmber"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Header Title and Count Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSectionHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/lora"
            android:textColor="@color/colorTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Ready to cook" />

        <TextView
            android:id="@+id/tvSectionHeaderCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_neutral"
            android:fontFamily="@font/inter"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="3 recipes" />
    </LinearLayout>

    <!-- Subtitle / Explanatory Text -->
    <TextView
        android:id="@+id/tvSectionHeaderSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter"
        android:textColor="@color/colorTextSecondary"
        android:textSize="13sp"
        tools:text="100% of required ingredients are on hand" />

</LinearLayout>
