<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="40dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_neutral" />

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_notifications"
                app:tint="@color/colorAccentAmber"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvExpirySheetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/lora"
                android:text="@string/expiry_nudge_title"
                android:textColor="@color/colorTextPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvExpirySheetSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter"
            android:lineSpacingExtra="2dp"
            android:text="@string/expiry_nudge_subtitle"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp" />

        <!-- Urgent Items Container Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/colorBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/llExpiryItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="?android:attr/dividerHorizontal"
                android:orientation="vertical"
                android:padding="16dp"
                android:showDividers="middle" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Recipe Teaser Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRecipeTeaser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/colorPillGreen"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/colorBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_restaurant"
                        app:tint="@color/colorAccentGreen"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tvRecipeTeaserTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/colorAccentGreen"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="2 recipes, all ingredients already at home" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRecipeTeaserDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/expiry_recipes_teaser_desc"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary Action Button: See recipes I can cook -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeeCookableRecipes"
            style="@style/Widget.PantryBuddy.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/action_see_cookable_recipes"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconTint="@color/white" />

        <!-- Secondary Action Button: Remind me today at 5 pm -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnoozeToday5pm"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter"
            android:text="@string/action_remind_today_5pm"
            android:textColor="@color/colorTextPrimary"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_clock"
            app:iconGravity="textStart"
            app:iconTint="@color/colorTextSecondary"
            app:strokeColor="@color/colorBorder"
            app:strokeWidth="1dp" />

        <!-- Safety Disclaimer Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/expiry_safety_disclaimer"
            android:textColor="@color/colorTextTertiary"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
